    "test": "cd backend && npm test && cd ../frontend && npm test",
    "build:frontend": "cd frontend && npm run build",
    "render-build": "chmod +x render-build.sh && ./render-build.sh"
  },
  "keywords": [
    "budget-planner",
    "physical-slider",
    "iot-simulation",
    "esp32",
