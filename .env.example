# Budget Planner Physical Slider - Environment Variables
# Copy this file to .env and fill in values

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DB_PATH=./backend/database/budget_planner.db
DEFAULT_BUDGET=5000
MAX_BUDGET=50000
SIMULATION_MODE=true

# ============================================================
# OPTIONAL: AWS Integration (NOT required for local simulation)
# ============================================================
# AWS_REGION=ap-south-1
# AWS_IOT_ENDPOINT=your-endpoint.iot.ap-south-1.amazonaws.com
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:ACCOUNT_ID:budget-alerts
# DYNAMODB_TABLE_NAME=budget-planner-data
